#!/usr/bin/env bash
set -euo pipefail

if ! command -v uv >/dev/null 2>&1; then
    printf 'ERROR: uv not found. Install it first: https://docs.astral.sh/uv/getting-started/installation/\n' >&2
    exit 1
fi

# --locked: fail if uv.lock is out of sync with pyproject.toml (run "make lock")
printf '==> ruff format --check .\n'
uv run --locked ruff format --check .

printf '==> ruff check .\n'
uv run --locked ruff check .

printf '==> ty check\n'
uv run --locked ty check
