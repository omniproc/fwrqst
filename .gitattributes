# Auto-detect text files, store them with LF and check them out with LF on every platform
# (independent of core.autocrlf)
* text=auto eol=lf

# Force LF line endings for shell scripts (required by bash)
*.sh      text eol=lf
.githooks/* text eol=lf

# Force LF for Makefile (GNU Make is LF-safe, avoids mixed endings)
Makefile  text eol=lf
